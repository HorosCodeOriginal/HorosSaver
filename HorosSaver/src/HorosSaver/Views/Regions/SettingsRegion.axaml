<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HorosSaver.ViewModels.Regions"
             xmlns:behaviors="using:HorosSaver.Behaviors"
             x:Class="HorosSaver.Views.Regions.SettingsRegion"
             x:DataType="vm:SettingsRegionViewModel">

    <Border Background="{StaticResource HorosPanelBrush}" Padding="24">
        <ScrollViewer behaviors:ScrollViewerWheelBehavior.EnableWheelOnHover="True">
            <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Einstellungen" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding InfoText}" TextWrapping="Wrap" Foreground="{StaticResource HorosTextSecondaryBrush}" />

                <Border Classes="program-card" BorderBrush="{StaticResource HorosBorderBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Snapshot-Einstellungen" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SnapshotSettingsHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HorosTextSecondaryBrush}"
                                   FontSize="12" />
                        <CheckBox Content="Inkrementell speichern (wenn Vorgänger existiert)"
                                  IsChecked="{Binding IncrementalSnapshotsEnabled}" />
                        <CheckBox Content="GZip-Kompression für neue Dateien"
                                  IsChecked="{Binding CompressSnapshotsEnabled}" />
                        <CheckBox Content="NTFS-ACLs mitkopieren (SDDL-Sidecar)"
                                  IsChecked="{Binding CopyAclsEnabled}" />
                    </StackPanel>
                </Border>

                <Border Classes="program-card" BorderBrush="{StaticResource HorosBorderBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Cursor Snapshot-Level" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CursorSnapshotSettingsHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HorosTextSecondaryBrush}"
                                   FontSize="12" />
                        <ComboBox ItemsSource="{Binding CursorSnapshotLevelOptions}"
                                  SelectedItem="{Binding SelectedCursorSnapshotLevelOption}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding CursorSnapshotLevelDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HorosTextSecondaryBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding CursorSnapshotSecretsHint}"
                                   IsVisible="{Binding ShowCursorSecretsHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HorosTealBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </Border>

                <Border Classes="program-card" BorderBrush="{StaticResource HorosBorderBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="System-Abbild" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SystemAbbildSettingsHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HorosTextSecondaryBrush}"
                                   FontSize="12" />
                        <ComboBox ItemsSource="{Binding SystemAbbildModeOptions}"
                                  SelectedItem="{Binding SelectedSystemAbbildModeOption}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding SystemAbbildModeDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HorosTextSecondaryBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding SystemAbbildAdminHint}"
                                   IsVisible="{Binding ShowSystemAbbildAdminHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HorosTealBrush}"
                                   FontSize="11" />
                        <StackPanel Spacing="4" IsVisible="{Binding ShowSystemAbbildDrivePicker}">
                            <TextBlock Text="Ziel-Laufwerk (Pflicht für Modus 1/3)"
                                       FontSize="11"
                                       Foreground="{StaticResource HorosTextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding SystemAbbildTargetDriveOptions}"
                                      SelectedItem="{Binding SelectedSystemAbbildTargetDriveOption}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Laufwerk wählen…">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding SystemAbbildWindowsBackupHint}"
                                       IsVisible="{Binding ShowSystemAbbildWindowsBackupHint}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HorosTealBrush}"
                                       FontSize="11" />
                            <StackPanel Spacing="4" IsVisible="{Binding ShowCustomSystemAbbildTargetPath}">
                                <TextBlock Text="Benutzerdefinierter Ordner"
                                           FontSize="11"
                                           Foreground="{StaticResource HorosTextSecondaryBrush}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SystemAbbildTarget}"
                                             IsReadOnly="True" />
                                    <Button Grid.Column="1"
                                            Classes="outline-action"
                                            Content="Laufwerk wählen"
                                            Margin="8,0,0,0"
                                            Command="{Binding UseSystemAbbildDriveTargetCommand}" />
                                </Grid>
                            </StackPanel>
                            <Button Classes="outline-action"
                                    Content="Anderen Ordner wählen…"
                                    HorizontalAlignment="Left"
                                    Command="{Binding BrowseSystemAbbildTargetCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding !IsSystemAbbildTargetRequired}">
                            <TextBlock Text="Zielpfad (optional, Standard: data\snapshots)"
                                       FontSize="11"
                                       Foreground="{StaticResource HorosTextSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SystemAbbildTarget}" />
                                <Button Grid.Column="1"
                                        Classes="outline-action"
                                        Content="Durchsuchen…"
                                        Margin="8,0,0,0"
                                        Command="{Binding BrowseSystemAbbildTargetCommand}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding SystemAbbildRestoreHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HorosTextSecondaryBrush}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding SystemAbbildBundleStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HorosTealBrush}"
                                   FontSize="11" />
                        <Button Classes="outline-action"
                                Content="Letztes Programm-Bundle wiederherstellen"
                                HorizontalAlignment="Left"
                                Command="{Binding RestoreSystemAbbildBundleCommand}" />
                    </StackPanel>
                </Border>

                <Border Classes="program-card" BorderBrush="{StaticResource HorosBorderBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="App-Reinstall-Engine" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EngineSettingsHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HorosTextSecondaryBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding EngineStatusMessage}"
                                   FontSize="12"
                                   Foreground="{StaticResource HorosTealBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Engine-Pfad" FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding EngineRootPath}" />
                                <Button Grid.Column="1"
                                        Classes="outline-action"
                                        Content="Übernehmen"
                                        Margin="8,0,0,0"
                                        Command="{Binding ApplyEnginePathCommand}" />
                            </Grid>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button Classes="outline-action" Margin="0,0,8,8" Content="Doctor"
                                    Command="{Binding RunEngineDoctorCommand}" />
                            <Button Classes="primary-action" Margin="0,0,8,8" Content="Inventar erfassen (Capture)"
                                    Command="{Binding RunEngineCaptureCommand}" />
                            <Button Classes="outline-action" Margin="0,0,8,8" Content="Initialize"
                                    Command="{Binding RunEngineInitializeCommand}" />
                            <Button Classes="outline-action" Margin="0,0,8,8" Content="Validate"
                                    Command="{Binding RunEngineValidateCommand}" />
                            <Button Classes="outline-action" Margin="0,0,8,8" Content="Status"
                                    Command="{Binding RunEngineStatusCommand}" />
                        </WrapPanel>

                        <TextBlock Text="Engine-Log" FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" />
                        <TextBox Text="{Binding EngineLog}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="140"
                                 MaxHeight="260"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="11" />
                    </StackPanel>
                </Border>

                <Border Classes="program-card" BorderBrush="{StaticResource HorosBorderBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Datenverzeichnis" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DataRoot}" FontFamily="Consolas, Courier New" FontSize="12" />
                        <TextBlock Text="Snapshots" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SnapshotsRoot}" FontFamily="Consolas, Courier New" FontSize="12" />
                        <TextBlock Text="Profile" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ProfilesFilePath}" FontFamily="Consolas, Courier New" FontSize="12" />
                        <TextBlock Text="Einstellungen" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SettingsFilePath}" FontFamily="Consolas, Courier New" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
