<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HorosSaver.ViewModels"
             xmlns:models="using:HorosSaver.Models"
             xmlns:conv="using:HorosSaver.Converters"
             xmlns:behaviors="using:HorosSaver.Behaviors"
             x:Class="HorosSaver.Views.Regions.RestoreWizardRegion"
             x:DataType="vm:RestoreWizardViewModel"
             x:Name="Root">

    <Border Background="{StaticResource HorosPanelBrush}" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource HorosTextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Panel Grid.Row="1">
                <Grid IsVisible="{Binding IsAuswahlStep}" RowDefinitions="*,*" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                            IsVisible="{Binding ShowBatchRestorePanels}"
                            Classes="program-card" BorderBrush="{StaticResource HorosBorderBrush}">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                                <TextBlock Text="Gruppen-Wiederherstellung" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding BatchGroupTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource HorosTealBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Programme und Snapshots der Gruppe — abwählen oder alle wiederherstellen."
                                           FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Button Classes="outline-action" Content="Alle" Command="{Binding ToggleAllBatchItemsCommand}" CommandParameter="{x:True}" />
                                <Button Classes="outline-action" Content="Keine" Command="{Binding ToggleAllBatchItemsCommand}" CommandParameter="{x:False}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="2"
                                          behaviors:ScrollViewerWheelBehavior.EnableWheelOnHover="True">
                                <ItemsControl ItemsSource="{Binding BatchItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RestoreBatchItemViewModel">
                                            <Border Margin="0,0,0,8" Padding="10" CornerRadius="8"
                                                    BorderBrush="{StaticResource HorosBorderBrush}" BorderThickness="1"
                                                    Background="{StaticResource HorosSurfaceBrush}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
                                                        <TextBlock Text="{Binding ProgramName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                                   Foreground="{StaticResource HorosTextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding SnapshotName}" FontSize="11"
                                                                   Foreground="{StaticResource HorosTealBrush}" />
                                                        <TextBlock Text="{Binding SnapshotDescription}" FontSize="10"
                                                                   Foreground="{StaticResource HorosTextSecondaryBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="0" IsVisible="{Binding ShowSingleRestorePanels}"
                            Classes="program-card" BorderBrush="{StaticResource HorosBorderBrush}">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                                <TextBlock Text="Programme" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Wählen Sie das Programm für die Wiederherstellung."
                                           FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" MaxHeight="220"
                                          behaviors:ScrollViewerWheelBehavior.EnableWheelOnHover="True">
                                <ItemsControl ItemsSource="{Binding Programs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RestoreProgramOptionViewModel">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,6"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding #Root.((vm:RestoreWizardViewModel)DataContext).SelectProgramCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Border Padding="8" CornerRadius="6"
                                                        BorderBrush="{StaticResource HorosBorderBrush}" BorderThickness="1"
                                                        Background="{StaticResource HorosSurfaceBrush}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <CheckBox IsChecked="{Binding IsSelected}" IsHitTestVisible="False" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource HorosTextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="10"
                                                                   Foreground="{StaticResource HorosTealBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" IsVisible="{Binding ShowSingleRestorePanels}"
                            Classes="program-card" BorderBrush="{StaticResource HorosBorderBrush}">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                                <TextBlock Text="Snapshot-Status" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Übersicht Ihrer gesicherten Snapshots."
                                           FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" />
                                <TextBlock Text="{Binding SnapshotSummary}" FontSize="11" Foreground="{StaticResource HorosTealBrush}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" MaxHeight="220"
                                          behaviors:ScrollViewerWheelBehavior.EnableWheelOnHover="True">
                                <ItemsControl ItemsSource="{Binding Snapshots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SnapshotItemViewModel">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding #Root.((vm:RestoreWizardViewModel)DataContext).SelectSnapshotCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Border Padding="10" CornerRadius="8"
                                                        BorderBrush="{StaticResource HorosTealBrush}" BorderThickness="1"
                                                        Background="{StaticResource HorosSurfaceBrush}">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                                   Foreground="{StaticResource HorosTextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" IsVisible="{Binding ShowSingleRestorePanels}"
                            Classes="program-card" BorderBrush="{StaticResource HorosBorderBrush}">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="Ordner &amp; Dateien" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Pfade aus dem Snapshot vor der Wiederherstellung an- oder abwählen."
                                           FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PreviewSummary}" FontSize="10" Foreground="{StaticResource HorosTealBrush}" TextWrapping="Wrap"
                                           IsVisible="{Binding ShowTargetPreview}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Button Classes="outline-action" Content="Alle" Command="{Binding ToggleAllPathsCommand}" CommandParameter="{x:True}" />
                                <Button Classes="outline-action" Content="Keine" Command="{Binding ToggleAllPathsCommand}" CommandParameter="{x:False}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="2" MaxHeight="180"
                                          behaviors:ScrollViewerWheelBehavior.EnableWheelOnHover="True">
                                <ItemsControl ItemsSource="{Binding PathOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RestorePathOptionViewModel">
                                            <Border Margin="0,0,0,6" Padding="8" CornerRadius="6"
                                                    Background="{StaticResource HorosSurfaceBrush}"
                                                    BorderBrush="{StaticResource HorosBorderBrush}" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SourcePath}" FontSize="10"
                                                                   Foreground="{StaticResource HorosTextSecondaryBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding TargetPath}" FontSize="10"
                                                                   Foreground="{StaticResource HorosTealBrush}" TextWrapping="Wrap"
                                                                   IsVisible="{Binding IsRemapped}" />
                                                        <TextBlock FontSize="10" Foreground="{StaticResource HorosTealBrush}">
                                                            <Run Text="{Binding TypeLabel}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding StatusLabel}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Grid.Row="{Binding ShowBatchRestorePanels, Converter={x:Static conv:BoolToGridRowConverter.Instance}}"
                            Grid.RowSpan="{Binding ShowBatchRestorePanels, Converter={x:Static conv:BoolToGridRowSpanConverter.Instance}}"
                            Classes="program-card" BorderBrush="{StaticResource HorosBorderBrush}">
                        <ScrollViewer MaxHeight="360"
                                      behaviors:ScrollViewerWheelBehavior.EnableWheelOnHover="True">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Wiederherstellen auf Zielsystem" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Wiederherstellungsziel und Start der Rückspielung."
                                               FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Modus" FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" />
                                    <StackPanel Spacing="4">
                                        <RadioButton Content="Originalpfade (Standard)"
                                                     IsChecked="{Binding IsOriginalPathsMode}"
                                                     Command="{Binding SetTargetModeCommand}"
                                                     CommandParameter="OriginalPaths" />
                                        <RadioButton Content="Staging / benutzerdefiniertes Root"
                                                     IsChecked="{Binding IsCustomRootMode}"
                                                     Command="{Binding SetTargetModeCommand}"
                                                     CommandParameter="CustomRoot" />
                                        <RadioButton Content="Alternatives Benutzerprofil"
                                                     IsChecked="{Binding IsAlternateUserProfileMode}"
                                                     Command="{Binding SetTargetModeCommand}"
                                                     CommandParameter="AlternateUserProfile" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding ShowCustomRootPicker}">
                                    <TextBlock Text="Ziel (Staging):" FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding CustomRootPath}"
                                                 behaviors:TextInputKeyboardBehavior.EnableNavigationKeys="True" />
                                        <Button Grid.Column="1" Classes="outline-action" Content="…" Margin="6,0,0,0"
                                                Command="{Binding BrowseCustomRootCommand}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding ShowAlternateProfilePicker}">
                                    <TextBlock Text="Alternatives Profil:" FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding AlternateUserProfilePath}"
                                                 behaviors:TextInputKeyboardBehavior.EnableNavigationKeys="True" />
                                        <Button Grid.Column="1" Classes="outline-action" Content="…" Margin="6,0,0,0"
                                                Command="{Binding BrowseAlternateProfileCommand}" />
                                    </Grid>
                                </StackPanel>

                                <CheckBox Content="Bestehende Dateien am Ziel überschreiben"
                                          IsChecked="{Binding OverwriteConfirmed}"
                                          IsVisible="{Binding ShowOverwriteConfirmation}" />

                                <CheckBox Content="Programm neu installieren (winget, wenn verfügbar)"
                                          IsChecked="{Binding ReinstallProgram}"
                                          IsVisible="{Binding ShowReinstallOption}" />

                                <TextBlock Text="{Binding InfoText}" FontSize="11" Foreground="{StaticResource HorosTextSecondaryBrush}" TextWrapping="Wrap" />

                                <Button Classes="primary-action"
                                        HorizontalAlignment="Stretch"
                                        Content="Wiederherstellung starten"
                                        IsDefault="True"
                                        Command="{Binding StartRestoreCommand}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border IsVisible="{Binding IsFortschrittStep}"
                        Classes="program-card"
                        BorderBrush="{StaticResource HorosTealBrush}"
                        Padding="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        MaxWidth="640">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Fortschritt" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="12" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding ProgressDetail}" FontSize="12" Foreground="{StaticResource HorosTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding IsErgebnisStep}"
                        Classes="program-card"
                        BorderBrush="{StaticResource HorosBorderBrush}"
                        Padding="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        MaxWidth="720">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <TextBlock Grid.Row="0" Text="Ergebnis" FontSize="18" FontWeight="SemiBold" />
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      behaviors:ScrollViewerWheelBehavior.EnableWheelOnHover="True">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ResultMessage}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource HorosTealBrush}" />
                                <ItemsControl ItemsSource="{Binding ResultDetails}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11"
                                                       Foreground="{StaticResource HorosTextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button Classes="outline-action"
                                    Content="Zurück zur Auswahl"
                                    Command="{Binding BackToAuswahlCommand}" />
                            <Button Classes="primary-action"
                                    Content="Fertig"
                                    IsDefault="True"
                                    Command="{Binding FinishCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Panel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,16,0,0"
                        IsVisible="{Binding IsAuswahlStep}">
                <Button Classes="outline-action"
                        Content="Abbrechen"
                        IsCancel="True"
                        Command="{Binding CancelWizardCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
