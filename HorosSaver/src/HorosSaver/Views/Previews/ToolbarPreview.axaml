<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:regions="using:HorosSaver.Views.Regions"
        xmlns:vm="using:HorosSaver.ViewModels.Previews"
        x:Class="HorosSaver.Views.Previews.ToolbarPreview"
        x:DataType="vm:ToolbarPreviewViewModel"
        Title="Preview: Toolbar"
        Width="1040"
        Height="150"
        WindowDecorations="None"
        CanResize="False"
        Background="{StaticResource HorosBackgroundBrush}">
    <Grid Width="1040" Height="120">
        <regions:ToolbarRegion x:Name="ToolbarRegion"
                               DataContext="{Binding}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />
    </Grid>
</Window>
