<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HorosSaver.ViewModels"
        xmlns:conv="using:HorosSaver.Converters"
        xmlns:regions="using:HorosSaver.Views.Regions"
        xmlns:behaviors="using:HorosSaver.Behaviors"
        x:Class="HorosSaver.Views.ProfilePathsWizardWindow"
        x:DataType="vm:ProfilePathsWizardViewModel"
        x:Name="Root"
        Title="{Binding WindowTitle}"
        Width="860"
        Height="640"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource HorosBackgroundBrush}">

    <Grid RowDefinitions="Auto,*">
        <regions:WindowChromeBar Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{StaticResource HorosTextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
            <Border Grid.Row="0"
                    Classes="program-card"
                    BorderBrush="{StaticResource HorosBorderBrush}"
                    Margin="0,0,0,12"
                    Padding="14"
                    IsVisible="{Binding IsCreateMode}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Profilname"
                               FontSize="12"
                               Foreground="{StaticResource HorosTextSecondaryBrush}" />
                    <TextBox Text="{Binding ProfileName}"
                             PlaceholderText="z. B. CopyQ Export, Scripts, NewPlusCyberpunk"
                             FontSize="13"
                             behaviors:TextInputKeyboardBehavior.EnableNavigationKeys="True" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Classes="program-card"
                    BorderBrush="{StaticResource HorosBorderBrush}"
                    Margin="0,0,0,12"
                    Padding="14"
                    IsVisible="{Binding IsCursorProfile}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Cursor Snapshot-Level"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding CursorSnapshotLevelOptions}"
                              SelectedItem="{Binding SelectedCursorSnapshotLevelOption}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding CursorSnapshotLevelDescription}"
                               FontSize="11"
                               Foreground="{StaticResource HorosTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CursorSnapshotSecretsHint}"
                               IsVisible="{Binding ShowCursorSecretsHint}"
                               FontSize="11"
                               Foreground="{StaticResource HorosTealBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Classes="program-card"
                    BorderBrush="{StaticResource HorosBorderBrush}"
                    Margin="0,0,0,12"
                    Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="Snapshot-Zielordner (optional)"
                               FontSize="12"
                               Foreground="{StaticResource HorosTextSecondaryBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomSnapshotRoot}"
                                 PlaceholderText="Standard: interner DataRoot — oder externen Ordner wählen"
                                 FontSize="12"
                                 behaviors:TextInputKeyboardBehavior.EnableNavigationKeys="True" />
                        <Button Grid.Column="1"
                                Classes="outline-action"
                                Content="Durchsuchen…"
                                Command="{Binding BrowseCustomSnapshotRootCommand}" />
                    </Grid>
                    <TextBlock Text="Neue Snapshots können hier standardmäßig abgelegt werden (Layout: snapshot/Programmname/…)."
                               FontSize="11"
                               Foreground="{StaticResource HorosTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Classes="program-card"
                    BorderBrush="{StaticResource HorosBorderBrush}"
                    Margin="0,0,0,12"
                    Padding="14">
                <TextBlock Text="{Binding PathHint}"
                           FontSize="11"
                           Foreground="{StaticResource HorosTextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,0,8">
                <Button Classes="outline-action"
                        Content="Datei hinzufügen…"
                        Command="{Binding AddFilePathCommand}" />
                <Button Classes="outline-action"
                        Content="Ordner hinzufügen…"
                        Command="{Binding AddFolderPathCommand}" />
            </StackPanel>

            <ScrollViewer Grid.Row="5"
                          behaviors:ScrollViewerWheelBehavior.EnableWheelOnHover="True">
                <ItemsControl ItemsSource="{Binding PathEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BindPathEntryViewModel">
                            <Border Classes="program-card"
                                    BorderBrush="{StaticResource HorosBorderBrush}"
                                    Margin="0,0,0,8"
                                    Padding="12">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                             Text="{Binding Label}"
                                             PlaceholderText="Bezeichnung"
                                             FontSize="12"
                                             behaviors:TextInputKeyboardBehavior.EnableNavigationKeys="True"
                                             Margin="0,0,0,6" />
                                    <CheckBox Grid.Row="0" Grid.Column="1"
                                              Content="Ordner"
                                              IsChecked="{Binding IsDirectory}"
                                              VerticalAlignment="Center" />

                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                             Text="{Binding SourcePath}"
                                             PlaceholderText="Absoluter Pfad (Datei oder Ordner)"
                                             FontSize="12"
                                             behaviors:TextInputKeyboardBehavior.EnableNavigationKeys="True"
                                             Margin="0,0,0,6" />

                                    <StackPanel Grid.Row="2" Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <Button Classes="outline-action"
                                                Content="Durchsuchen…"
                                                Command="{Binding #Root.((vm:ProfilePathsWizardViewModel)DataContext).BrowsePathCommand}"
                                                CommandParameter="{Binding .}" />
                                        <TextBlock Text="{Binding ExistsLabel}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource HorosTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Grid.Row="2" Grid.Column="1"
                                            Classes="outline-action"
                                            Content="Entfernen"
                                            Command="{Binding #Root.((vm:ProfilePathsWizardViewModel)DataContext).RemovePathCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Classes="outline-action"
                    Content="Abbrechen"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />
            <Button Classes="primary-action"
                    Content="{Binding FinishButtonLabel}"
                    IsDefault="True"
                    Command="{Binding FinishCommand}" />
        </StackPanel>
        </Grid>
    </Grid>
</Window>
