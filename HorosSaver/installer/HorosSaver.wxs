<?xml version="1.0" encoding="UTF-8"?>
<!--
  HorosSaver WiX installer (fallback when Inno Setup is unavailable).
  PublishOutput ComponentGroup is generated by heat in build-installer.ps1.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define ProductName = "HorosSaver" ?>
  <?define ProductVersion = "1.0.0.0" ?>
  <?define Manufacturer = "HorosCode" ?>
  <?define UpgradeCode = "A7C3E9F1-4B2D-4E8A-9C1F-000000000001" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="HorosSaverIcon" SourceFile="..\src\HorosSaver\Assets\horossaver-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="HorosSaverIcon" />

    <Feature Id="ProductFeature" Title="HorosSaver" Level="1">
      <ComponentGroupRef Id="PublishOutput" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="HorosSaver" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="HorosCode" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <Component Id="StartMenuShortcut" Guid="B1C2D3E4-F5A6-4789-ABCD-EF0123456701" Directory="ApplicationProgramsFolder">
      <Shortcut Id="StartMenuShortcut"
                Name="HorosSaver"
                Description="HorosCode HorosSaver"
                Target="[INSTALLFOLDER]HorosSaver.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\HorosCode\HorosSaver" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Guid="C2D3E4F5-A6B7-4890-BCDE-F01234567012" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcut"
                Name="HorosSaver"
                Description="HorosCode HorosSaver"
                Target="[INSTALLFOLDER]HorosSaver.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\HorosCode\HorosSaver" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Product>
</Wix>
