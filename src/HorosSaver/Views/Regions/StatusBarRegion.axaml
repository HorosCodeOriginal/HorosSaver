<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HorosSaver.ViewModels.Regions"
             x:Class="HorosSaver.Views.Regions.StatusBarRegion"
             x:DataType="vm:StatusBarRegionViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Border Background="{StaticResource HorosSurfaceBrush}"
            BorderBrush="{StaticResource HorosBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,7"
            MinHeight="32"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <Path Data="{StaticResource IconGrid}"
                      Width="12"
                      Height="12"
                      Stretch="Uniform"
                      Stroke="{StaticResource HorosTextSecondaryBrush}"
                      StrokeThickness="1.2"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding LeftLabel}"
                           FontSize="11"
                           Foreground="{StaticResource HorosTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="0"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconTerminal}"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          Stroke="{StaticResource HorosTextSecondaryBrush}"
                          StrokeThickness="1.2"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ShellLabel}"
                               FontSize="11"
                               Foreground="{StaticResource HorosTextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Width="1"
                        Height="14"
                        Background="{StaticResource HorosBorderBrush}"
                        Margin="12,0"
                        VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconWindows}"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          Stroke="{StaticResource HorosTextSecondaryBrush}"
                          StrokeThickness="1.2"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OsLabel}"
                               FontSize="11"
                               Foreground="{StaticResource HorosTextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
