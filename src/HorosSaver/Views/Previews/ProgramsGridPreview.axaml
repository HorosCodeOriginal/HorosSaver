<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:regions="using:HorosSaver.Views.Regions"
        xmlns:vm="using:HorosSaver.ViewModels.Previews"
        x:Class="HorosSaver.Views.Previews.ProgramsGridPreview"
        x:DataType="vm:ProgramsGridPreviewViewModel"
        Title="Preview: App-Profile Grid"
        Width="700"
        Height="1040"
        WindowDecorations="None"
        CanResize="False"
        Background="{StaticResource HorosBackgroundBrush}">
    <Grid Width="700" Height="1040">
        <regions:ProgramsRegion x:Name="ProgramsRegion"
                                DataContext="{Binding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
    </Grid>
</Window>
